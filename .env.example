# ── Required ──────────────────────────────────────────
API_ID=
API_HASH=
BOT_TOKEN=
OWNER_ID=

# ── Optional ──────────────────────────────────────────
ADMIN_IDS=                 # extra admins, comma separated
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PREMIUM_PRICE_INR=100
PREMIUM_DAYS=30
FREE_DAILY_LIMIT=2
FREE_MAX_FILE_MB=20
PREMIUM_MAX_FILE_MB=200
MAX_CONCURRENT_JOBS=2
MAX_PARALLEL_REQUESTS=8
WORKER_SECRET=             # same value on all workers (X-Worker-Key)
WORKER_PING_INTERVAL=480
DIRECT_FALLBACK=true       # use Google directly if all workers are down
FORCE_SUB_CHANNEL=         # e.g. @mychannel
SUPPORT_CONTACT=@admin
DATA_DIR=data
