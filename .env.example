# Copy to .env and fill in.  Keep comments on their OWN line: systemd's
# EnvironmentFile (used by epub-bot.service / oracle_setup.sh) does NOT strip
# inline "# comments" — they become part of the value.

# ── Required ──────────────────────────────────────────
API_ID=
API_HASH=
BOT_TOKEN=
OWNER_ID=

# ── Optional ──────────────────────────────────────────
# extra admins, comma separated
ADMIN_IDS=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Plans (all prices INR) ─────────────────────────────
# Free tier — metered in CHARACTERS per day (any number of files).
# 1,000,000 chars ≈ two average light-novel volumes.
FREE_DAILY_CHARS=1000000
FREE_MAX_FILE_MB=20
# Telegram Stars ⭐ — paid inside Telegram, no Razorpay/UPI needed, works worldwide.
# 60 ⭐ = 1 month Premium (same benefits as PREMIUM_*). Set STARS_ENABLED=0 to hide.
STARS_ENABLED=1
STARS_PREMIUM_PRICE=60
STARS_PREMIUM_DAYS=30
# Starter Pack: one-time, credits never expire
STARTER_PRICE_INR=10
STARTER_CREDITS=5
# Bulk Pack: one-time, credits never expire
BULK_PRICE_INR=40
BULK_CREDITS=25
# max file size when paying with a credit
CREDIT_MAX_FILE_MB=50
# Basic: monthly, limited per day
BASIC_PRICE_INR=50
BASIC_DAYS=30
BASIC_DAILY_LIMIT=5
BASIC_MAX_FILE_MB=50
# Premium: monthly, unlimited, priority queue
PREMIUM_PRICE_INR=100
PREMIUM_DAYS=30
PREMIUM_MAX_FILE_MB=200
# Premium 3 months
PREMIUM3_PRICE_INR=250
PREMIUM3_DAYS=90

MAX_CONCURRENT_JOBS=2

# ── Speed tuning (defaults are tuned for ~5 min on a 14M-char book) ──
# total in-flight requests per job
MAX_PARALLEL_REQUESTS=48
# parallel requests per worker (HF / PythonAnywhere / Vercel / Render)
WORKER_CONCURRENCY=8
# master → Google directly, in parallel with workers (0 = fallback only)
DIRECT_CONCURRENCY=6
# segments per request
BATCH_MAX_ITEMS=150
# chars per request (worker MAX_CHARS must be higher)
BATCH_MAX_CHARS=9000
# same value on ALL workers (X-Worker-Key header)
WORKER_SECRET=
WORKER_PING_INTERVAL=480
# use Google directly if all workers are down
DIRECT_FALLBACK=true
# e.g. @mychannel or -1001234567890
FORCE_SUB_CHANNEL=
SUPPORT_CONTACT=@admin
DATA_DIR=data

# ── Output options (format conversion + splitting, docconv.py) ──
# split-size buttons offered to users (MB); "no split" is always available
SPLIT_PRESETS_MB=10,20,50
# smallest custom split a user may type (KB) and Telegram's per-file cap (MB)
SPLIT_MIN_KB=512
TG_MAX_FILE_MB=2000
# seconds the "choose output" panel waits before starting with the defaults
OPTIONS_TIMEOUT=90

# ── Full-screen message effects (🔥 🎉 ❤️ bursting over the whole chat) ──
# ❤️ on /start · 🎉 when the translated file arrives · 🔥 on payments.
# Private chats only, no Premium needed. Set 0 to disable.
EFFECTS_ENABLED=1
