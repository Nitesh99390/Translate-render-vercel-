# ── Required ──────────────────────────────────────────
API_ID=
API_HASH=
BOT_TOKEN=
OWNER_ID=

# ── Optional ──────────────────────────────────────────
ADMIN_IDS=                 # extra admins, comma separated
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PREMIUM_PRICE_INR=100
PREMIUM_DAYS=30
FREE_DAILY_LIMIT=2
FREE_MAX_FILE_MB=20
PREMIUM_MAX_FILE_MB=200
MAX_CONCURRENT_JOBS=2

# ── Speed tuning (defaults are tuned for ~5 min on a 14M-char book) ──
MAX_PARALLEL_REQUESTS=48   # total in-flight requests per job
WORKER_CONCURRENCY=8       # parallel requests per worker (HF / PythonAnywhere / Vercel / Render)
DIRECT_CONCURRENCY=6       # master → Google directly, in parallel with workers (0 = fallback only)
BATCH_MAX_ITEMS=150        # segments per request
BATCH_MAX_CHARS=9000       # chars per request (worker MAX_CHARS must be higher)
WORKER_SECRET=             # same value on ALL workers (X-Worker-Key header)
WORKER_PING_INTERVAL=480
DIRECT_FALLBACK=true       # use Google directly if all workers are down
FORCE_SUB_CHANNEL=         # e.g. @mychannel
SUPPORT_CONTACT=@admin
DATA_DIR=data
